{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.alpendata.ch/schemas/agentbox-tenant-v1.json",
  "title": "AlpenData AgentBox tenant",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agentbox.alpendata.ch/v1" },
    "kind": { "const": "Tenant" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "hostRoot", "publicOrigin", "provider", "documents"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "hostRoot": { "type": "string", "pattern": "^/" },
        "publicOrigin": { "type": "string", "format": "uri" },
        "gatewayPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "timezone": { "type": "string", "minLength": 1 },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["token", "trusted-proxy"] },
            "trustedProxies": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "userHeader": { "type": "string", "minLength": 1 },
            "requiredHeaders": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "allowUsers": {
              "type": "array",
              "items": { "type": "string", "minLength": 3 }
            }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "apiKeyEnv"],
          "properties": {
            "model": { "type": "string", "minLength": 3 },
            "apiKeyEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "sources"],
          "properties": {
            "backend": {
              "type": "object",
              "additionalProperties": false,
              "required": ["baseUrl", "datasetId", "apiKeyEnv"],
              "properties": {
                "baseUrl": { "type": "string", "format": "uri" },
                "datasetId": { "type": "string", "minLength": 1 },
                "apiKeyEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                "allowPrivateNetwork": { "type": "boolean" }
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "type"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
                  "type": {
                    "enum": ["google-drive", "local", "microsoft-365", "webdav"]
                  },
                  "allowPrivateNetwork": { "type": "boolean" }
                }
              }
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
          }
        }
      }
    }
  }
}
