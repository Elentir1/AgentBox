{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.alpendata.ch/schemas/agentbox-tenant-v1.json",
  "title": "AlpenData AgentBox tenant",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agentbox.alpendata.ch/v1" },
    "kind": { "const": "Tenant" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "hostRoot",
        "publicOrigin",
        "identity",
        "provider",
        "subscription",
        "documents"
      ],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "hostRoot": { "type": "string", "pattern": "^/" },
        "publicOrigin": { "type": "string", "format": "uri" },
        "gatewayPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "timezone": { "type": "string", "minLength": 1 },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["token", "trusted-proxy"] },
            "trustedProxies": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "userHeader": { "type": "string", "minLength": 1 },
            "requiredHeaders": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "allowUsers": {
              "type": "array",
              "items": { "type": "string", "minLength": 3 }
            }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "apiKeyEnv"],
          "properties": {
            "model": { "type": "string", "minLength": 3 },
            "apiKeyEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "baseUrl": { "type": "string", "format": "uri" },
            "api": { "enum": ["openai-completions", "openai-responses"] },
            "models": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "name": { "type": "string", "minLength": 1 },
                  "contextWindow": { "type": "integer", "minimum": 1 },
                  "maxTokens": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "subscription": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planId", "status", "quotas"],
          "properties": {
            "planId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
            "status": { "enum": ["active", "grace", "suspended"] },
            "validUntil": { "type": "string", "format": "date-time" },
            "quotas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxSources",
                "maxDocuments",
                "maxStorageBytes",
                "minSyncIntervalMinutes"
              ],
              "properties": {
                "maxSources": { "type": "integer", "minimum": 1, "maximum": 50 },
                "maxDocuments": { "type": "integer", "minimum": 1, "maximum": 50000 },
                "maxStorageBytes": { "type": "integer", "minimum": 1048576 },
                "minSyncIntervalMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
              }
            }
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["embedding", "sources"],
          "properties": {
            "embedding": {
              "type": "object",
              "additionalProperties": false,
              "required": ["baseUrl", "model", "apiKeyEnv"],
              "properties": {
                "baseUrl": { "type": "string", "format": "uri" },
                "model": { "type": "string", "minLength": 1 },
                "apiKeyEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                "dimensions": { "type": "integer", "minimum": 1 },
                "allowPrivateNetwork": { "type": "boolean" }
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "type"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
                  "type": {
                    "enum": ["google-drive", "local", "microsoft-365", "webdav"]
                  },
                  "root": { "type": "string" },
                  "driveId": { "type": "string" },
                  "baseUrl": { "type": "string", "format": "uri" },
                  "rootPath": { "type": "string" },
                  "entraTenantIdEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                  "clientIdEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                  "clientSecretEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                  "refreshTokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                  "usernameEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                  "passwordEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                  "allowPrivateNetwork": { "type": "boolean" }
                }
              }
            }
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
          }
        }
      }
    }
  }
}
