# RAGFlow settings for one AgentBox customer. Reference material only: nothing in
# this repository deploys or manages RAGFlow. Copy it next to RAGFlow's own
# docker-compose.yml, which you get from the RAGFlow release you pin below.
#
# RAGFlow is deployed PER CUSTOMER and stays OUTSIDE the AgentBox Compose
# project. One dataset per tenant, named <tenant-id> or <tenant-id>-something:
# the AgentBox plugin refuses to start against a dataset that is not scoped to
# its tenant, and reports it as a critical security-audit finding.
#
# Host requirements: CPU >= 4 cores, RAM >= 16 GB, disk >= 50 GB,
# and vm.max_map_count >= 262144 for the bundled Elasticsearch.

# Pin an exact version. Verify after every upgrade that the HTTP API still
# serves the routes extensions/agentbox/src/ragflow-client.ts calls:
#   POST   /api/v1/datasets/<dataset>/documents
#   PATCH  /api/v1/datasets/<dataset>/documents/<id>
#   POST   /api/v1/datasets/<dataset>/chunks
#   DELETE /api/v1/datasets/<dataset>/documents
#   GET    /api/v1/datasets/<dataset>
#   POST   /api/v1/retrieval
# A version that drops one of these breaks indexing without breaking the UI.
RAGFLOW_IMAGE=infiniflow/ragflow:v0.27.1

# Bind RAGFlow to loopback and reach it from the Gateway over a private network
# or a TLS proxy. A public RAGFlow port is a second, unauthenticated door to the
# customer's documents.
SVR_HTTP_PORT=9380

# Since v0.22 only the slim image ships and it carries NO embedding models, so
# RAGFlow needs an external embedding service. Point it at the same
# OpenAI-compatible endpoint the tenant manifest uses, so documents and queries
# stay with one provider under one contract. Set these in RAGFlow's own model
# configuration; they are listed here so the two sides are chosen together.
#   base URL:  https://api.infomaniak.com/2/ai/<product-id>/openai/v1
#   embedding: an embedding model offered by that endpoint
#
# If a tenant must never send document text to a hosted endpoint, run a local
# embedding server on the tenant host instead and point RAGFlow at that.
